# PostgreSQL Neon: único requisito do ambiente online após rodar db:migrate.
DATABASE_URL=
# Alternativa compatível com integrações Vercel Postgres:
# POSTGRES_URL=

# Opcionais: sobrepõem as chaves criadas no banco pela migração.
# ADMIN_SETUP_TOKEN=
# ADMIN_SESSION_SECRET=

# Opcionais: arquivos privados no Blob; não é necessário para o catálogo ou lojas.
# BLOB_READ_WRITE_TOKEN=

# Apenas testes locais SEM DATABASE_URL:
# LOCAL_DATA_DIR=.local-data

# Recuperação de senha do Clube por e-mail (Resend):
# RESEND_API_KEY=
# EMAIL_FROM=Tio Lira <contato@seu-dominio-verificado.com>
# SITE_URL=https://seu-dominio.com

# Compras avulsas: configurar primeiro no Sandbox; nunca usar NEXT_PUBLIC_.
# ASAAS_ENVIRONMENT=sandbox
# ASAAS_API_KEY=
# Token exclusivo do webhook, de 32 a 255 caracteres, diferente da API key:
# ASAAS_WEBHOOK_TOKEN=

# Retorno do cartão ativo por padrão com SITE_URL: cadastre esse domínio no Asaas.
# Para desabilitar explicitamente:
# ASAAS_PAYMENT_REDIRECT_ENABLED=false

# Compras internacionais: país do cadastro fora de BR -> PayPal / USD.
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_ID=
# PAYPAL_WEBHOOK_ID=
# SITE_URL deve ser a origem HTTPS oficial. Sem esses campos, PayPal fica indisponível.
# Regra de preço padrão: R$ / 6, arredondado aos centavos. Override priceUsdCents no admin.
