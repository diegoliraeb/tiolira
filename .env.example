# In production: connect a PRIVATE Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
# Choose a strong random setup code; it is used only to create the first administrator.
ADMIN_SETUP_TOKEN=
# Random secret with at least 32 characters for signing administrator sessions.
ADMIN_SESSION_SECRET=
# Local development only. Never enable this on Vercel.
LOCAL_DATA_DIR=.local-data
